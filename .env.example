# LabLink Environment Configuration Template
# NOTE: Client code contains ZERO secrets. Secrets are only read by the optional backend proxy.

# Port for local development
PORT=3000

# Optional Google Gemini API Key for server proxy enhancement (never committed or exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional FastAPI Engine URL (defaults to client-side pure TypeScript engine if unreachable)
VITE_ENGINE_API_URL=http://localhost:8000

# Optional Supabase Database Backend (defaults to LocalStorage + deterministic PRNG seed if not configured)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
